      "waitBetweenTries": 2500,
      "maxTries": 5
    },
    {
      "parameters": {
        "jsCode": "try {\n  // Attempt to extract the data array, fallback to the raw json if it's an array itself\n  let results = $input.item.json.data || $input.item.json;\n  \n  // Ensure results is actually an array before trying to iterate over it\n  if (!Array.isArray(results)) {\n    // If the API returns { total: 0, offset: 0 } without a data array\n    results = [];\n  }\n\n  // If the array is empty, return a polite fallback message instead of throwing an error\n  if (results.length === 0) {\n    return { response: \"No papers found for this query. Try broadening your search terms.\" };\n  }\n\n  let parsedString = \"\";\n  results.forEach((r, index) => {\n    parsedString += `[Paper ${index + 1}]\\n`;\n    if (r.paperId) parsedString += `Paper ID: ${r.paperId}\\n`;\n    parsedString += `Title: ${r.title}\\n`;\n    parsedString += `Year: ${r.year || \"Unknown\"}\\n`;\n    \n    // Safely check for nested properties\n    if (r.tldr && r.tldr.text) {\n      parsedString += `TLDR: ${r.tldr.text}\\n`;\n    }\n    \n    if (r.abstract) {\n      parsedString += `Abstract: ${r.abstract}\\n`;\n    }\n    \n    if (r.openAccessPdf && r.openAccessPdf.url) {\n      parsedString += `PDF URL: ${r.openAccessPdf.url}\\n`;\n    } else if (r.url) {\n      parsedString += `URL: ${r.url}\\n`;\n    }\n    parsedString += `\\n`;\n  });\n\n  return { response: parsedString };\n  \n} catch (error) {\n  // Catch any unexpected parsing errors and return them cleanly back to the LLM\n  // so the Agent doesn't crash and get stuck in an endless retry loop\n  return { \n    response: `System Message (API Error): Could not parse Semantic Scholar output. Ensure the search query was valid. Error details: ${error.message}` \n  };\n}"
      },
