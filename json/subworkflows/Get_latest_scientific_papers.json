      "id": "64d59e73-ffc6-4042-8253-f0f44d7d8dcd",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\n// Loop through all inputs received from the Merge node\nfor (const item of $input.all()) {\n  const response = item.json;\n\n  // Check if the response contains the 'data' array\n  if (response && response.data) {\n    for (const paper of response.data) {\n      // Only keep papers with an abstract, otherwise we can't embed anything useful\n      if (!paper.abstract) continue;\n\n      // Flatten the authors array into a comma-separated string\n      const authors = paper.authors ? paper.authors.map(a => a.name).join(', ') : 'Unknown';\n      \n      // Prefer the direct PDF link if available, otherwise use the Semantic Scholar URL\n      const pdfUrl = paper.openAccessPdf && paper.openAccessPdf.url ? paper.openAccessPdf.url : null;\n      const sourceUrl = pdfUrl || paper.url;\n\n      items.push({\n        json: {\n          title: paper.title || 'Untitled',\n          abstract: paper.abstract,\n          authors: authors,\n          year: paper.year,\n          source_url: sourceUrl\n        }\n      });\n    }\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
